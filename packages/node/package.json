{
  "name": "@civaapple/qi-node",
  "version": "0.7.1",
  "description": "Node.js storage, workspace, tools, extensions, and transport adapters for Qi",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "default": "./dist/paths.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    },
    "./workspace": {
      "types": "./dist/workspace/index.d.ts",
      "default": "./dist/workspace/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.js"
    },
    "./skills": {
      "types": "./dist/skills/index.d.ts",
      "default": "./dist/skills/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./codeact": {
      "types": "./dist/codeact/index.d.ts",
      "default": "./dist/codeact/index.js"
    },
    "./scheduler": {
      "types": "./dist/scheduler/index.d.ts",
      "default": "./dist/scheduler/index.js"
    },
    "./stream": {
      "types": "./dist/stream/index.d.ts",
      "default": "./dist/stream/index.js"
    },
    "./extensions": {
      "types": "./dist/extensions/index.d.ts",
      "default": "./dist/extensions/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@civaapple/qi-agent": "0.7.1",
    "@civaapple/qi-protocol": "0.7.1",
    "@sinclair/typebox": "0.34.52",
    "diff": "9.0.0",
    "tar": "^7.5.22",
    "yaml": "2.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/civaapple-alt/qi.git",
    "directory": "packages/node"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
