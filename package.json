{
  "name": "qi-monorepo",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "accept:preview": "node scripts/preview-acceptance.mjs",
    "accept:coding-agent": "node scripts/real-provider-coding-acceptance.mjs",
    "build": "tsc -b",
    "build:cli": "node scripts/build-cli-package.mjs",
    "clean": "tsc -b --clean",
    "qi": "node apps/cli/dist/main.js",
    "qi:web": "node apps/web/dist/main.js",
    "pack:cli": "node scripts/build-cli-package.mjs --pack",
    "packages:audit": "node scripts/check-package-readiness.mjs",
    "packages:check": "npm run build && node scripts/check-package-readiness.mjs && node scripts/package-consumer-smoke.mjs",
    "packages:plan": "node scripts/package-release-plan.mjs",
    "release:audit": "node scripts/source-release-audit.mjs",
    "release:archive": "node scripts/build-source-archive.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc -b --pretty false",
    "verify:focused": "node scripts/verify-focused.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/civaapple-alt/qi.git"
  },
  "homepage": "https://github.com/civaapple-alt/qi#readme",
  "bugs": {
    "url": "https://github.com/civaapple-alt/qi/issues"
  },
  "license": "MIT"
}
